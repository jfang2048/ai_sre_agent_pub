# syntax=docker/dockerfile:1
ARG GO_VERSION=1.25.7
ARG NODE_VERSION=22
ARG DEBIAN_RELEASE=bookworm
ARG VERSION=v0.9
ARG COMMIT=dev
ARG BUILD_DATE=unknown
ARG REPO_URL=
ARG REPO_REF=

FROM debian:${DEBIAN_RELEASE}-slim AS source
ARG REPO_URL
ARG REPO_REF
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git rsync \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY . /src-context
RUN if [ -n "${REPO_URL}" ]; then \
      git clone "${REPO_URL}" /tmp/repo; \
      if [ -n "${REPO_REF}" ]; then \
        git -C /tmp/repo fetch --depth 1 origin "${REPO_REF}" && git -C /tmp/repo checkout FETCH_HEAD; \
      fi; \
      rsync -a --delete /tmp/repo/ /work/; \
    else \
      rsync -a --delete /src-context/ /work/; \
    fi \
    && rm -rf /work/.git /tmp/repo /src-context

FROM golang:${GO_VERSION}-${DEBIAN_RELEASE} AS go-builder
ARG VERSION
ARG COMMIT
ARG BUILD_DATE
WORKDIR /src
COPY --from=source /work/backend/go.mod /work/backend/go.sum ./backend/
RUN cd backend && go mod download
COPY --from=source /work/backend/ ./backend/
RUN CGO_ENABLED=0 GOOS=linux go -C backend build \
    -trimpath \
    -ldflags "-s -w -X github.com/jfang2048/ai_sre_agent_pub/internal/pkg/release.Version=${VERSION} -X github.com/jfang2048/ai_sre_agent_pub/internal/pkg/release.Commit=${COMMIT} -X github.com/jfang2048/ai_sre_agent_pub/internal/pkg/release.BuildDate=${BUILD_DATE}" \
    -o /out/sre-controller ./cmd/controller

FROM node:${NODE_VERSION}-${DEBIAN_RELEASE}-slim AS web-builder
WORKDIR /src/frontend
COPY --from=source /work/frontend/package.json /work/frontend/package-lock.json ./
RUN npm ci
COPY --from=source /work/frontend/ ./
RUN npm run build -- --outDir /out/web

FROM debian:${DEBIAN_RELEASE}-slim AS runtime
ARG VERSION
ARG COMMIT
ARG BUILD_DATE
ARG REPO_URL
ARG REPO_REF
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 ai-sre-agent \
    && useradd --uid 10001 --gid 10001 --home-dir /var/lib/ai-sre-agent --shell /usr/sbin/nologin --create-home ai-sre-agent \
    && mkdir -p /etc/ai-sre-agent /var/lib/ai-sre-agent/controller \
    && chown -R 10001:10001 /etc/ai-sre-agent /var/lib/ai-sre-agent
LABEL org.opencontainers.image.title="AI SRE Agent Controller" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${REPO_URL}" \
      org.opencontainers.image.ref.name="${REPO_REF}" \
      org.opencontainers.image.licenses="GPL-3.0"
COPY --from=go-builder /out/sre-controller /usr/local/bin/sre-controller
COPY --from=source --chown=10001:10001 /work/scripts/run-controller.sh /usr/local/bin/run-controller.sh
COPY --from=web-builder --chown=10001:10001 /out/web /var/lib/ai-sre-agent/controller/web
COPY --from=source --chown=10001:10001 /work/configs/container/controller.yaml /etc/ai-sre-agent/controller.yaml
COPY --from=source --chown=10001:10001 /work/configs/container/controller_targets.yaml /etc/ai-sre-agent/controller_targets.yaml
COPY --from=source --chown=10001:10001 /work/configs/agent_playbooks.yaml /var/lib/ai-sre-agent/controller/configs/agent_playbooks.yaml
COPY --from=source --chown=10001:10001 /work/dataset /var/lib/ai-sre-agent/controller/dataset
RUN chmod +x /usr/local/bin/run-controller.sh \
    && mkdir -p /var/lib/ai-sre-agent/controller/data \
    && chown -R 10001:10001 /var/lib/ai-sre-agent/controller
ENV SRE_CONTROLLER_CONFIG=/etc/ai-sre-agent/controller.yaml \
    SRE_CONTROLLER_TARGETS_FILE=/etc/ai-sre-agent/controller_targets.yaml \
    SRE_CONTROLLER_HTTP_LISTEN=0.0.0.0:8080 \
    SRE_CONTROLLER_GRPC_LISTEN=0.0.0.0:9090 \
    SRE_CONTROLLER_WEB_PATH=/var/lib/ai-sre-agent/controller/web
WORKDIR /var/lib/ai-sre-agent/controller
VOLUME ["/var/lib/ai-sre-agent/controller/data"]
EXPOSE 8080 9090
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 CMD curl -fsS http://127.0.0.1:8080/healthz >/dev/null || exit 1
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/run-controller.sh"]
CMD ["--log-format", "json"]
