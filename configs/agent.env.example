# Copy this file to configs/agent.env and edit values.
# The run script will auto-load configs/agent.env when you pass --enable-agent.
#
# Usage:
#   cp configs/agent.env.example configs/agent.env
#   ./scripts/run-local.sh --enable-agent

# Keep safe by default.
SRE_AGENT_DRY_RUN=1
SRE_AGENT_LLM_ENABLED=1
SRE_AGENT_REQUIRE_APPROVAL_TOKEN=1

# Optional execute guardrails
# SRE_AGENT_ACTION_APPROVAL_TTL=30m
# SRE_AGENT_MAX_PENDING_ACTIONS=2048
# SRE_AGENT_MAX_ACTIONS_PER_QUERY=8
# SRE_AGENT_MAX_CONCURRENT_QUERIES=16
# SRE_AGENT_MAX_TELEMETRY_AGE=2m
# SRE_AGENT_ALLOW_ACTIONS_ON_STALE_DATA=0
# SRE_AGENT_SKIP_LLM_ON_STALE_TELEMETRY=1
# SRE_AGENT_SKIP_LLM_ON_NO_TELEMETRY=1
# SRE_AGENT_ACTION_TIMEOUT=15s
# SRE_AGENT_MAX_PARALLEL_ACTION_EXEC=4
# SRE_AGENT_EXPLAINABILITY_EVIDENCE_MAX=8
# SRE_AGENT_EVENT_WEBHOOK_URL=http://127.0.0.1:9001/agent/events
# SRE_AGENT_EVENT_WEBHOOK_TOKEN=
# SRE_AGENT_EVENT_WEBHOOK_TIMEOUT=2s
# SRE_AGENT_EVENT_PUBLISH_RETRIES=1
# SRE_AGENT_EVENT_RETRY_BACKOFF=200ms
# SRE_AGENT_EVENT_SLACK_WEBHOOK_URL=
# SRE_AGENT_EVENT_PAGERDUTY_ROUTING_KEY=
# SRE_AGENT_EVENT_PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue

# Optional controller-side TSDB passthrough when running locally with external InfluxDB
# SRE_TSDB_ENABLED=0
# SRE_TSDB_URL=http://127.0.0.1:8086
# SRE_TSDB_ORG=ai-sre-agent
# SRE_TSDB_BUCKET=controller_metrics
# SRE_TSDB_TOKEN=
# SRE_TSDB_RETENTION=168h

# Local RAG configuration
# SRE_AGENT_RAG_ENABLED=1
# SRE_AGENT_RAG_DATASET_PATH=./dataset
# SRE_AGENT_RAG_INDEX_PATH=./data/agent/rag/index.json
# SRE_AGENT_RAG_SOURCE_PATHS=
# SRE_AGENT_RAG_TOP_K=5
# SRE_AGENT_RAG_MAX_SNIPPET_CHARS=280
# SRE_AGENT_RAG_CHUNK_SIZE=900
# SRE_AGENT_RAG_CHUNK_OVERLAP=120
# SRE_AGENT_RAG_CHUNK_STRATEGY=auto
# SRE_AGENT_RAG_RETRIEVAL_MODE=hybrid
# SRE_AGENT_RAG_EMBEDDING_PROVIDER=local
# SRE_AGENT_RAG_EMBEDDING_MODEL=local-hash-64
# SRE_AGENT_RAG_EMBEDDING_BASE_URL=
# SRE_AGENT_RAG_EMBEDDING_API_KEY=
# SRE_AGENT_RAG_REBUILD_POLICY=manual

# Deterministic workflow engine controls (joint-risk + RCA)
# SRE_AGENT_WORKFLOW_ENABLED=1
# SRE_AGENT_WORKFLOW_WINDOW=45m
# SRE_AGENT_WORKFLOW_MAX_WINDOW=6h
# SRE_AGENT_WORKFLOW_MAX_SAMPLES=1200
# SRE_AGENT_WORKFLOW_MAX_SIGNALS=18
# SRE_AGENT_WORKFLOW_MAX_HYPOTHESES=6
# SRE_AGENT_WORKFLOW_AUDIT_RETENTION=500
# SRE_AGENT_WORKFLOW_DRY_RUN=1
# SRE_AGENT_WORKFLOW_REQUIRE_APPROVAL=1
# SRE_AGENT_WORKFLOW_ALLOW_PROFILING_EXEC=0
# SRE_AGENT_WORKFLOW_PROFILING_COMMAND=echo profiling-disabled
# SRE_AGENT_WORKFLOW_HIGH_RISK_THRESHOLD=0.75
# SRE_AGENT_WORKFLOW_MEDIUM_RISK_THRESHOLD=0.45
# SRE_AGENT_WORKFLOW_DATA_PATH=./data/agent/workflows
# SRE_AGENT_WORKFLOW_STORE_PATH=./data/agent/workflow_runs.db
# SRE_AGENT_WORKFLOW_VERIFICATION_WINDOW=2m
# SRE_AGENT_WORKFLOW_TOOL_RETRY_COUNT=1
# SRE_AGENT_WORKFLOW_POLICY_VERSION=workflow-policy/v1
# SRE_AGENT_WORKFLOW_AUTO_ROLLBACK_ON_VERIFICATION_FAILURE=0
# Optional interface-only insights metadata:
# SRE_AGENT_WORKFLOW_INSIGHTS_ENABLED=0
# SRE_AGENT_WORKFLOW_INSIGHTS_PROVIDER=openai
# SRE_AGENT_WORKFLOW_INSIGHTS_MODEL=gpt-4o-mini
# SRE_AGENT_WORKFLOW_INSIGHTS_API_KEY_ENV=SRE_AGENT_LLM_API_KEY

# ============================================================
# OpenAI mode (uncomment this block)
# ============================================================
# SRE_AGENT_LLM_PROVIDER=openai
# SRE_AGENT_LLM_MODEL=gpt-4o-mini
# SRE_AGENT_LLM_API_KEY=
# SRE_AGENT_LLM_BASE_URL=https://api.openai.com/v1

# ============================================================
# Local Ollama mode (uncomment this block)
# Requires:
#   1) ollama serve
#   2) ollama pull llama3.1:8b
# ============================================================
# SRE_AGENT_LLM_PROVIDER=ollama
# SRE_AGENT_LLM_MODEL=llama3.1:8b
# SRE_AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SRE_AGENT_LLM_API_KEY=
