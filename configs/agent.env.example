# Copy this file to configs/agent.env and edit values.
# The run script will auto-load configs/agent.env when you pass --enable-agent.
#
# Usage:
#   cp configs/agent.env.example configs/agent.env
#   ./scripts/run-local.sh --enable-agent

# Keep safe by default.
SRE_AGENT_DRY_RUN=1
SRE_AGENT_LLM_ENABLED=1
SRE_AGENT_REQUIRE_APPROVAL_TOKEN=1

# Optional execute guardrails
# SRE_AGENT_ACTION_APPROVAL_TTL=30m
# SRE_AGENT_MAX_PENDING_ACTIONS=2048
# SRE_AGENT_MAX_ACTIONS_PER_QUERY=8
# SRE_AGENT_MAX_CONCURRENT_QUERIES=16
# SRE_AGENT_MAX_TELEMETRY_AGE=2m
# SRE_AGENT_ALLOW_ACTIONS_ON_STALE_DATA=0
# SRE_AGENT_SKIP_LLM_ON_STALE_TELEMETRY=1
# SRE_AGENT_SKIP_LLM_ON_NO_TELEMETRY=1
# SRE_AGENT_ACTION_TIMEOUT=15s
# SRE_AGENT_MAX_PARALLEL_ACTION_EXEC=4
# SRE_AGENT_EXPLAINABILITY_EVIDENCE_MAX=8
# SRE_AGENT_EVENT_WEBHOOK_URL=http://127.0.0.1:9001/agent/events
# SRE_AGENT_EVENT_WEBHOOK_TOKEN=
# SRE_AGENT_EVENT_WEBHOOK_TIMEOUT=2s
# SRE_AGENT_EVENT_PUBLISH_RETRIES=1
# SRE_AGENT_EVENT_RETRY_BACKOFF=200ms
# SRE_AGENT_EVENT_SLACK_WEBHOOK_URL=
# SRE_AGENT_EVENT_PAGERDUTY_ROUTING_KEY=
# SRE_AGENT_EVENT_PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue

# Optional explicit runtime controls (Haystack planner/context/tools/memory)
# SRE_AGENT_REASONING_ENABLED=1
# SRE_AGENT_RUNTIME_BACKEND=haystack
# SRE_AGENT_RUNTIME_FAIL_OPEN=1
# SRE_AGENT_CONTEXT_ENABLED=1
# SRE_AGENT_CONTEXT_PATHS=README.md,docs,configs
# SRE_AGENT_TOOL_TIMEOUT_SECONDS=2
# SRE_AGENT_TOOL_RETRIES=1
# SRE_AGENT_MEMORY_MAX_EVENTS=1000
# SRE_AGENT_MEMORY_FILE=./data/agent/runtime-memory.jsonl

# ============================================================
# OpenAI mode (uncomment this block)
# ============================================================
# SRE_AGENT_LLM_PROVIDER=openai
# SRE_AGENT_LLM_MODEL=gpt-4o-mini
# SRE_AGENT_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# SRE_AGENT_LLM_BASE_URL=https://api.openai.com/v1

# ============================================================
# Local Ollama mode (uncomment this block)
# Requires:
#   1) ollama serve
#   2) ollama pull llama3.1:8b
# ============================================================
# SRE_AGENT_LLM_PROVIDER=ollama
# SRE_AGENT_LLM_MODEL=llama3.1:8b
# SRE_AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SRE_AGENT_LLM_API_KEY=
