# Local defaults (single host)
SRE_CONTROLLER_CONFIG=./configs/controller.yaml
SRE_COLLECTOR_CONFIG=./configs/collector.yaml
SRE_COLLECTOR_CONTROLLER_ENDPOINTS=127.0.0.1:9090

# Optional: enable eBPF reader (requires privileged sidecar emitting to the socket below)
# SRE_COLLECTOR_EBPF_ENABLED=1
# SRE_COLLECTOR_EBPF_SOCKET_PATH=/var/run/sre_collector_ebpf.sock
# SRE_COLLECTOR_EBPF_CATEGORIES=sched,io,net,mem,gpu,security,syscall

# Optional: enable C++ probe-core as primary low-level collector
# SRE_COLLECTOR_PROBE_CORE_ENABLED=1
# SRE_COLLECTOR_PROBE_CORE_BINARY_PATH=./build/sre-probe-core
# SRE_COLLECTOR_PROBE_CORE_COLLECTORS=host,network,rdma,process  # or "all"
# SRE_COLLECTOR_PROBE_CORE_COMPRESSION=none
# SRE_COLLECTOR_PROBE_CORE_QUEUE_DEPTH=16
# SRE_COLLECTOR_PROBE_CORE_WINDOW_SAMPLES=6
# SRE_COLLECTOR_PROBE_CORE_GPU_INTERVAL_SAMPLES=5
# SRE_COLLECTOR_PROBE_CORE_STALE_AFTER=15s
# SRE_COLLECTOR_PROBE_CORE_FALLBACK_TO_GO=1

# Optional: inventory + Kubernetes integration
# SRE_INVENTORY_ENABLED=1
# SRE_INVENTORY_HEARTBEAT_TTL=90s
# SRE_K8S_ENABLED=1
# SRE_K8S_REFRESH_INTERVAL=20s
# SRE_K8S_REQUEST_TIMEOUT=6s

# Optional: orchestration SLO/remediation policy
# SRE_ORCHESTRATION_SLO_BREACH_RATIO=1.05
# SRE_ORCHESTRATION_SLO_BREACH_CONSECUTIVE=2
# SRE_ORCHESTRATION_AUTO_REMEDIATION_ENABLED=1
# SRE_ORCHESTRATION_REMEDIATION_COOLDOWN=90s
# SRE_ORCHESTRATION_REMEDIATIONS_PER_RECONCILE=2
# SRE_ORCHESTRATION_REMEDIATIONS_PER_WORKLOAD=4
# SRE_ORCHESTRATION_REMEDIATION_MIN_IMPROVEMENT=0.12

# Optional: enable Haystack context-aware reasoning runtime
# SRE_AGENT_REASONING_ENABLED=1
# SRE_AGENT_RUNTIME_BACKEND=haystack
# SRE_AGENT_RUNTIME_FAIL_OPEN=1
# SRE_AGENT_CONTEXT_ENABLED=1
# SRE_AGENT_CONTEXT_PATHS="README.md,docs,configs"
# SRE_AGENT_LLM_ENABLED=1
# SRE_AGENT_LLM_PROVIDER=openai
# SRE_AGENT_LLM_MODEL=gpt-4o-mini
# SRE_AGENT_LLM_API_KEY=sk-xxx
