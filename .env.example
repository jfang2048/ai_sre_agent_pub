# ============================================================================
# AI SRE Agent v0.5 Environment Template
# ============================================================================
# Copy to .env for local development. Keep real secrets only in local env.

# ----------------------------------------------------------------------------
# Core paths/endpoints
# ----------------------------------------------------------------------------
SRE_CONTROLLER_CONFIG=./configs/controller.yaml
SRE_COLLECTOR_CONFIG=./configs/collector.yaml
SRE_COLLECTOR_CONTROLLER_ENDPOINTS=127.0.0.1:9090

# Optional listener overrides
# SRE_CONTROLLER_HTTP_LISTEN=127.0.0.1:8080
# SRE_CONTROLLER_GRPC_LISTEN=127.0.0.1:9090
# SRE_CONTROLLER_WEB_PATH=./web

# ----------------------------------------------------------------------------
# Ingest retention + persistence
# ----------------------------------------------------------------------------
# SRE_INGEST_NODE_RETENTION=24h
# SRE_INGEST_HISTORY_SAMPLES_PER_NODE=1440
# SRE_INGEST_MAX_NODES=5000
# SRE_INGEST_PERSIST_ENABLED=1
# SRE_INGEST_PERSIST_PATH=./data/controller/ingest/store.db
# SRE_INGEST_PERSIST_SYNC_INTERVAL=5s
# SRE_INGEST_PERSIST_COMPACTION_INTERVAL=30m
# SRE_INGEST_PERSIST_MAX_DB_BYTES=536870912

# ----------------------------------------------------------------------------
# Analysis layer (rules/statistics/ML + optional LLM)
# ----------------------------------------------------------------------------
# SRE_ANALYSIS_ML_ANOMALY_ENABLED=1
# SRE_ANALYSIS_ML_METHOD=seasonal_baseline
# SRE_ANALYSIS_ML_SEASONAL_PERIOD=12
# SRE_ANALYSIS_ML_SCORE_THRESHOLD=3.0
# SRE_ANALYSIS_CROSS_NODE_CORRELATION=1

# Optional LLM settings (only when enabled in controller config)
# SRE_AGENT_LLM_ENABLED=1
# SRE_AGENT_LLM_PROVIDER=openai
# SRE_AGENT_LLM_MODEL=gpt-4o-mini
# SRE_AGENT_LLM_BASE_URL=https://api.openai.com/v1
# SRE_AGENT_LLM_API_KEY=
# SRE_AGENT_JIMMYNIGHT_API_KEY=
# SRE_AGENT_LLM_TIMEOUT=20s
# SRE_AGENT_LLM_MAX_QUERY_CHARS=2000
# SRE_AGENT_LLM_MAX_TOKENS=700
# SRE_AGENT_LLM_MAX_RETRIES=3
# SRE_AGENT_LLM_RETRY_BASE=300ms
# SRE_AGENT_LLM_RETRY_MAX=3s
# SRE_AGENT_LLM_RATE_LIMIT_RPS=2.0
# SRE_AGENT_LLM_RATE_BURST=2

# Optional local RAG retrieval wiring
# SRE_AGENT_RAG_ENABLED=0
# SRE_AGENT_RAG_INDEX_PATH=var/rag/index.json
# SRE_AGENT_RAG_DOC_PATHS=README.md,docs,configs
# SRE_AGENT_RAG_TOP_K=3
# SRE_AGENT_RAG_MAX_SNIPPET_CHARS=400

# ----------------------------------------------------------------------------
# Agent query service guardrails
# ----------------------------------------------------------------------------
# SRE_AGENT_DRY_RUN=1
# SRE_AGENT_REQUIRE_APPROVAL_TOKEN=1
# SRE_AGENT_ACTION_APPROVAL_TTL=30m
# SRE_AGENT_MAX_PENDING_ACTIONS=2048
# SRE_AGENT_MAX_ACTIONS_PER_QUERY=8
# SRE_AGENT_MAX_CONCURRENT_QUERIES=16
# SRE_AGENT_MAX_TELEMETRY_AGE=2m
# SRE_AGENT_ALLOW_ACTIONS_ON_STALE_DATA=0
# SRE_AGENT_SKIP_LLM_ON_STALE_TELEMETRY=1
# SRE_AGENT_SKIP_LLM_ON_NO_TELEMETRY=1
# SRE_AGENT_ACTION_TIMEOUT=15s
# SRE_AGENT_MAX_PARALLEL_ACTION_EXEC=4
# SRE_AGENT_EXPLAINABILITY_EVIDENCE_MAX=8

# Optional outbound event hooks
# SRE_AGENT_EVENT_WEBHOOK_URL=
# SRE_AGENT_EVENT_WEBHOOK_TOKEN=
# SRE_AGENT_EVENT_WEBHOOK_TIMEOUT=2s
# SRE_AGENT_EVENT_PUBLISH_RETRIES=1
# SRE_AGENT_EVENT_RETRY_BACKOFF=200ms
# SRE_AGENT_EVENT_SLACK_WEBHOOK_URL=
# SRE_AGENT_EVENT_PAGERDUTY_ROUTING_KEY=
# SRE_AGENT_EVENT_PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue

# ----------------------------------------------------------------------------
# Deterministic workflow engine (joint-risk + RCA)
# ----------------------------------------------------------------------------
# SRE_AGENT_WORKFLOW_ENABLED=1
# SRE_AGENT_WORKFLOW_WINDOW=45m
# SRE_AGENT_WORKFLOW_MAX_WINDOW=6h
# SRE_AGENT_WORKFLOW_MAX_SAMPLES=1200
# SRE_AGENT_WORKFLOW_MAX_SIGNALS=18
# SRE_AGENT_WORKFLOW_MAX_HYPOTHESES=6
# SRE_AGENT_WORKFLOW_AUDIT_RETENTION=500
# SRE_AGENT_WORKFLOW_DRY_RUN=1
# SRE_AGENT_WORKFLOW_REQUIRE_APPROVAL=1
# SRE_AGENT_WORKFLOW_ALLOW_PROFILING_EXEC=0
# SRE_AGENT_WORKFLOW_PROFILING_COMMAND=echo profiling-disabled
# SRE_AGENT_WORKFLOW_HIGH_RISK_THRESHOLD=0.75
# SRE_AGENT_WORKFLOW_MEDIUM_RISK_THRESHOLD=0.45
# SRE_AGENT_WORKFLOW_INSIGHTS_ENABLED=0
# SRE_AGENT_WORKFLOW_INSIGHTS_PROVIDER=openai
# SRE_AGENT_WORKFLOW_INSIGHTS_MODEL=gpt-4o-mini
# SRE_AGENT_WORKFLOW_INSIGHTS_API_KEY_ENV=SRE_AGENT_LLM_API_KEY

# ----------------------------------------------------------------------------
# HA and Kubernetes-safe remediation gate
# ----------------------------------------------------------------------------
# SRE_CONTROLLER_HA_ENABLED=0
# SRE_CONTROLLER_HA_MODE=active
# SRE_AGENT_K8S_REMEDIATION_ENABLED=0

# Optional collector-provided package vulnerability hint
# SRE_COLLECTOR_SECURITY_PACKAGE_VULN_COUNT=0

# ----------------------------------------------------------------------------
# Optional controller API auth key (if auth enabled in controller yaml)
# ----------------------------------------------------------------------------
# SRE_AGENT_CONTROLLER_API_KEY=
