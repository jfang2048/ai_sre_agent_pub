# ============================================================================
# Example Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# ============================================================================
# LLM Analysis Configuration (Optional)
# ============================================================================
# API key for LLM-enhanced root cause analysis
# Supported providers: openai, anthropic, google/gemini, local
SRE_AGENT_LLM_API_KEY=your-api-key-here
SRE_AGENT_LLM_PROVIDER=openai
SRE_AGENT_LLM_MODEL=gpt-4o-mini
# SRE_AGENT_LLM_BASE_URL=https://api.openai.com/v1  # Optional: custom API endpoint

# ============================================================================
# Controller API Authentication (Optional)
# ============================================================================
# API key for controller endpoints (set auth.enabled=true in controller config)
SRE_AGENT_CONTROLLER_API_KEY=your-controller-api-key

# ============================================================================
# Collector Push Endpoints
# ============================================================================
# Comma-separated controller gRPC endpoints
SRE_COLLECTOR_CONTROLLER_ENDPOINTS=localhost:9090

# ============================================================================
# Database (if using external storage)
# ============================================================================
# SRE_AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/sreagent
# SRE_AGENT_REDIS_URL=redis://localhost:6379

# ============================================================================
# Notification Services
# ============================================================================
# Slack webhook for alerts
SRE_AGENT_ALERTING_NOTIFIERS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty integration
SRE_AGENT_ALERTING_NOTIFIERS_PAGERDUTTY_API_KEY=your-pagerduty-api-key
SRE_AGENT_ALERTING_NOTIFIERS_PAGERDUTTY_SERVICE_KEY=your-service-key

# ============================================================================
# External Alerting Endpoints
# ============================================================================
SRE_AGENT_ALERTING_WEBHOOK_URL=https://your-endpoint.com/alerts
SRE_AGENT_ALERTING_WEBHOOK_HEADERS=Authorization=Bearer YOUR_TOKEN

# ============================================================================
# External Checks (Optional)
# ============================================================================
# Example bearer token used by checks.header_env/auth_bearer_env
SRE_AGENT_CHECK_HTTP_BEARER_TOKEN=your-bearer-token

# ============================================================================
# GPU Collection (Optional)
# ============================================================================
# Set to 1 to disable GPU telemetry (when nvidia-smi is present)
# SRE_COLLECTOR_GPU_DISABLED=1

# ============================================================================
# C++ Shared Memory (Optional)
# ============================================================================
# Ingest C++ SDK metrics via shared memory
# SRE_COLLECTOR_SHM_ENABLED=1
# SRE_COLLECTOR_SHM_NAME=/sre_collector_metrics

# ============================================================================
# gRPC Compression (Optional)
# ============================================================================
# Enable gzip compression for telemetry stream
# SRE_COLLECTOR_GRPC_COMPRESS=1

# ============================================================================
# Kubernetes Configuration (if applicable)
# ============================================================================
SRE_AGENT_KUBERNETES_CONFIG_PATH=/path/to/kubeconfig
SRE_AGENT_KUBERNETES_NAMESPACE=default
SRE_AGENT_KUBERNETES_IN_CLUSTER=false

# ============================================================================
# Storage Configuration
# ============================================================================
SRE_AGENT_STORAGE_PATH=/var/lib/sre-agent/data
SRE_AGENT_RETENTION_HOURS=168

# ============================================================================
# TLS/SSL Certificates
# ============================================================================
SRE_AGENT_TLS_CERT_FILE=/path/to/cert.pem
SRE_AGENT_TLS_KEY_FILE=/path/to/key.pem
SRE_AGENT_TLS_CA_FILE=/path/to/ca.pem
