# Container-first defaults for docker compose and helper scripts.
# Copy to .env at the repo root when you want to customize the stack locally.

SRE_VERSION=v0.95

# Optional remote source override for Docker builds. Leave empty to build from the
# local checkout; set these when you want the Docker build to clone a fork/ref.
REPO_URL=
REPO_REF=

SRE_BIND_HOST=127.0.0.1
SRE_CONTROLLER_HTTP_PORT=8080
SRE_CONTROLLER_GRPC_PORT=9090
SRE_TSDB_PORT=8086

# Docker runtime behavior
SRE_DOCKER_NETWORK_MODE=auto
# DOCKER_BUILD_NETWORK=host

# Optional host-side config mounts for role-specific docker run helpers.
# SRE_CONTROLLER_CONFIG_FILE=./configs/container/controller.yaml
# SRE_CONTROLLER_TARGETS_MOUNT=./configs/controller_targets.yaml
# SRE_COLLECTOR_CONFIG_FILE=./configs/container/collector.yaml

# Controller behavior
SRE_INGEST_PERSIST_ENABLED=1
SRE_AGENT_RAG_ENABLED=1
SRE_AGENT_RAG_REBUILD_POLICY=if_missing
SRE_AGENT_LLM_ENABLED=0
SRE_AGENT_DRY_RUN=1
# Closed-loop workflow defaults stay conservative unless you explicitly enable
# execution. The durable run/evidence paths may be overridden for Docker volumes
# or externalized controller storage.
SRE_AGENT_WORKFLOW_ENABLED=1
SRE_AGENT_WORKFLOW_DRY_RUN=1
SRE_AGENT_WORKFLOW_REQUIRE_APPROVAL=1
# SRE_AGENT_WORKFLOW_DATA_PATH=./data/agent/workflows
# SRE_AGENT_WORKFLOW_STORE_PATH=./data/agent/workflow_runs.db
# SRE_AGENT_WORKFLOW_VERIFICATION_WINDOW=2m
# SRE_AGENT_WORKFLOW_TOOL_RETRY_COUNT=1
# SRE_AGENT_WORKFLOW_POLICY_VERSION=workflow-policy/v1
# SRE_AGENT_WORKFLOW_AUTO_ROLLBACK_ON_VERIFICATION_FAILURE=0

# Collector behavior
SRE_COLLECTOR_COLLECTION_INTERVAL=5s
SRE_COLLECTOR_LEVEL=5
# Probe-core is the primary host telemetry path in v0.95.
# SRE_COLLECTOR_PROBE_CORE_ENABLED=1
# SRE_COLLECTOR_PROBE_CORE_BINARY_PATH=/usr/local/bin/sre-probe-core
# Collector security audit combines eBPF runtime events, probe-core process data,
# and compatibility /proc posture scans into structured findings.
# SRE_COLLECTOR_SECURITY_ENABLED=1
# SRE_COLLECTOR_SECURITY_AUDIT_INTERVAL=5m
# SRE_COLLECTOR_SECURITY_RECENT_EVENT_LIMIT=128
# Single-node demo default. Remote collectors must override this to the central
# controller gRPC address reachable from the collector host.
SRE_COLLECTOR_CONTROLLER_ENDPOINTS=controller:9090
SRE_COLLECTOR_METRICS_BIND_HOST=127.0.0.1
SRE_COLLECTOR_METRICS_PORT=9464

# Optional controller-side TSDB overlay values
SRE_TSDB_ENABLED=0
SRE_TSDB_PROVIDER=influxdb
SRE_TSDB_URL=http://influxdb:8086
SRE_TSDB_ORG=ai-sre-agent
SRE_TSDB_BUCKET=controller_metrics
SRE_TSDB_TOKEN=dev-influx-token
SRE_TSDB_RETENTION=168h
SRE_TSDB_FALLBACK_TO_MEMORY=1
SRE_TSDB_MANAGE_BUCKET=0

# Optional external LLM / embedding providers
# SRE_AGENT_LLM_PROVIDER=openai
# SRE_AGENT_LLM_MODEL=gpt-4o-mini
# SRE_AGENT_LLM_API_KEY=
# SRE_AGENT_RAG_EMBEDDING_PROVIDER=openai
# SRE_AGENT_RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SRE_AGENT_RAG_EMBEDDING_API_KEY=
