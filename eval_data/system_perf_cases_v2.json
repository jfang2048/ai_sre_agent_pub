      "id": "memory_leak_diagnose",
      "suites": ["fast", "regression", "benchmark"],
      "task_type": "diagnose",
      "incident_type": "memory",
      "fault_domain": "memory",
      "difficulty": "easy",
      "robustness_category": "clean",
      "description": "Sustained RSS growth with reclaim pressure: the agent must name the memory fault object, not just a symptom.",
      "incident_case_id": "memory_leak_trend",
      "ground_truth": {
        "no_incident": false,
        "expected_anomaly_present": true,
        "root_cause": {
          "entities": ["memory", "checkout-api"],
          "aliases": ["memory pressure", "reclaim", "memory leak", "rss growth", "oom"],
          "reason": "checkout-api leaks memory (~250MB/min RSS growth), raising reclaim pressure and trending the node toward OOM.",
          "fault_domain": "memory",
          "fault_domain_aliases": ["runtime"],
          "propagation_chain": [
            "checkout-api memory leak (rss growth)",
            "node memory reclaim pressure",
            "service latency degradation",
            "potential node oom"
          ],
          "affected_services": ["checkout"]
        },
        "required_evidence": ["rss growth", "reclaim"],
        "acceptable_remediation": ["inspect top rss processes", "cat /proc/pressure/memory", "capture heap profile", "restart checkout-api"],
        "forbidden_remediation": ["kill -9", "rm -rf", "drop caches"],
        "expected_tools_any": [["runbook_retrieval", "similar_case_retrieval"]],
        "irrelevant_tools": [],
        "forbidden_tools": [],
        "expected_verdict_any": ["insufficient_evidence"]
      }
    },
