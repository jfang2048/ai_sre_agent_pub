              {"name": "node_cpu_usage_percent", "sequence": [34, 36, 38, 71, 79, 83, 85]},
              {"name": "node_memory_MemTotal_bytes", "mode": "constant", "value": 100},
              {"name": "node_memory_Used_bytes", "sequence": [48, 49, 50, 52, 53, 54, 55]}
