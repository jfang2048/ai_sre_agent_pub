{
  "schema_version": "v1",
  "cases": [
    {
      "id": "memory_leak_full_runtime",
      "suites": ["fast", "regression", "benchmark"],
      "description": "The full multi-agent runtime should preserve explicit analysis, JSON handoff, governed validation, post-action status, evidence, and memory for the memory-pressure incident.",
      "incident_type": "memory",
      "incident_case_id": "memory_leak_trend",
      "seeded_context": "Sustained RSS growth, reclaim pressure, warning logs, and a real memory-pressure RCA path.",
      "expected_root_cause_any": ["memory pressure and reclaim", "memory leak"],
      "expected_validated_recommendation_substrings": ["inspect top RSS processes", "run: cat /proc/pressure/memory"],
      "expected_governance_behavior": {
        "require_message_protocol": true,
        "require_validation_agent": true,
        "expected_validation_mode": "bounded_react",
        "expected_execution_category": "read_only_validation",
        "expect_dry_run": true
      },
      "expected_post_action_outcome": {
        "expected_verdict_any": ["insufficient_evidence"],
        "expected_fallback_mode": "not_executed"
      },
      "expected_artifact_coverage": {
        "require_analysis_handoff": true,
        "require_validation_report": true,
        "require_action_plan": true,
        "require_post_action_validation": true,
        "require_evidence_package": true,
        "require_memory_writeback": true,
        "required_message_types": [
          "analysis_handoff",
          "validation_request",
          "validation_result",
          "action_decision",
          "post_action_validation"
        ]
      }
    },
