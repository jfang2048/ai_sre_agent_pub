{
  "schema_version": "v1",
  "cases": [
    {
      "id": "memory_leak_trend",
      "suites": ["fast", "regression", "benchmark"],
      "description": "Sustained memory growth with reclaim pressure should be treated as a trend-driven memory-risk case.",
      "collector_id": "eval-memory-leak",
      "query": "why is this node likely to run out of memory soon",
      "trigger": "incident_alert",
      "window_minutes": 50,
      "scenario": {
        "duration_minutes": 44,
        "step_minutes": 1,
        "metric_series": [
          {"name": "node_cpu_usage_percent", "mode": "linear", "start": 38, "step": 0.35, "max": 58},
          {"name": "node_memory_MemTotal_bytes", "mode": "constant", "value": 17179869184},
          {"name": "node_memory_Used_bytes", "mode": "linear", "start": 9663676416, "step": 183500800, "max": 16043212800},
          {"name": "node_pressure_memory_some_avg10", "mode": "linear", "start": 2.0, "step": 0.35, "max": 18},
          {"name": "node_pressure_memory_full_avg10", "mode": "linear", "start": 0.5, "step": 0.18, "max": 8},
          {"name": "node_disk_request_latency_p99_seconds", "mode": "constant", "value": 0.012},
          {"name": "node_pressure_io_full_avg10", "mode": "constant", "value": 2.0},
          {"name": "node_tcp_retransmit_ratio", "mode": "constant", "value": 0.002},
          {"name": "service_latency_p95_ms", "mode": "linear", "start": 180, "step": 1.5, "max": 260}
        ],
        "processes": [
          {"pid": 2100, "name": "checkout-api", "cpu_percent": 44, "rss_bytes": 8912896000, "io_read_bps": 2200000, "io_write_bps": 450000}
        ],
        "logs": [
          {
            "every": 4,
            "fingerprint": "memory_growth",
            "example": "warn rss growth 250MB/min and reclaim spikes on checkout-api",
            "level": "warn",
            "service": "checkout",
            "process": "checkout-api",
            "count_start": 2,
            "count_step": 1
          }
        ]
      },
      "expected": {
        "expected_trend_keys": ["memory_pressure"],
        "expected_event_categories": ["trend_watch"],
        "expected_tool_calls": ["runbook_retrieval", "similar_case_retrieval"],
        "root_cause_any": ["memory pressure and reclaim", "memory leak"],
        "fault_domains": ["memory", "runtime"],
        "required_evidence": ["rss growth", "reclaim"],
        "required_recommendation_substrings": ["inspect top RSS processes", "run: cat /proc/pressure/memory"],
        "forbidden_recommendation_substrings": ["rm -rf", "kill -9", "drop caches -f"],
        "required_retrieval_paths": ["memory-pressure-runbook.md"],
        "query_should_use_rag": true,
        "rag_should_improve_recommendations": true
      }
    },
    {
